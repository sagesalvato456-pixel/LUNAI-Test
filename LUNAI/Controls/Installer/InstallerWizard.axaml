<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LUNAI.ViewModels"
             xmlns:models="clr-namespace:LUNAI.Models"
             x:Class="LUNAI.Controls.Installer.InstallerWizard"
             x:DataType="vm:InstallerViewModel"
             Background="{StaticResource Lunai.BackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource Lunai.SurfaceBrush}"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- App accent dot -->
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <DynamicResource ResourceKey="{Binding AccentKey}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding AppName}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Lunai.TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="LUNAI Installer"
                           FontSize="12"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Step content ─────────────────────────────────────── -->
        <Panel Grid.Row="1">

            <!-- Step 0: Welcome -->
            <StackPanel IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Welcome}}"
                        Spacing="16" Margin="24" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Welcome"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AppName}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Ecosystem}"
                           FontSize="13"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Description}"
                           FontSize="14"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="300" />
            </StackPanel>

            <!-- Step 1: License -->
            <Grid IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.License}}"
                  RowDefinitions="Auto,*,Auto"
                  Margin="24">
                <TextBlock Grid.Row="0"
                           Text="License Agreement"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <Border Grid.Row="1"
                        Background="{StaticResource Lunai.SurfaceHighBrush}"
                        CornerRadius="8" Padding="12">
                    <ScrollViewer>
                        <TextBlock Text="MIT License&#10;&#10;Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the &quot;Software&quot;), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:&#10;&#10;The above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.&#10;&#10;THE SOFTWARE IS PROVIDED &quot;AS IS&quot;, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED."
                                   FontSize="12"
                                   Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <CheckBox Grid.Row="2"
                          IsChecked="{Binding LicenseAccepted}"
                          Content="I accept the license agreement"
                          Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                          Margin="0,12,0,0" />
            </Grid>

            <!-- Step 2: Downloading -->
            <StackPanel IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Download}}"
                        Spacing="16" Margin="24" VerticalAlignment="Center">
                <TextBlock Text="Downloading"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}" />
                <ProgressBar Value="{Binding DownloadFraction}"
                             Minimum="0" Maximum="1"
                             Height="8" CornerRadius="4"
                             Foreground="{StaticResource Lunai.PrimaryBrush}"
                             Background="{StaticResource Lunai.SurfaceHighBrush}" />
                <TextBlock Text="{Binding DownloadLabel}"
                           FontSize="12"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}" />
            </StackPanel>

            <!-- Step 3: Installing (system intent) -->
            <StackPanel IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Installing}}"
                        Spacing="16" Margin="24" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Installing"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True"
                             Height="8" CornerRadius="4"
                             Foreground="{StaticResource Lunai.PrimaryBrush}"
                             Background="{StaticResource Lunai.SurfaceHighBrush}" />
                <TextBlock Text="Waiting for system install confirmation..."
                           FontSize="12"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Step 4: Done -->
            <StackPanel IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Done}}"
                        Spacing="16" Margin="24" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="✓"
                           FontSize="48"
                           Foreground="{StaticResource Lunai.SuccessBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Installation complete!"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding AppName}"
                           FontSize="14"
                           Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Step 5: Error -->
            <StackPanel IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Error}}"
                        Spacing="16" Margin="24" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="✕"
                           FontSize="48"
                           Foreground="{StaticResource Lunai.ErrorBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Installation failed"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource Lunai.ErrorBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           MaxWidth="300" />
            </StackPanel>

        </Panel>

        <!-- ── Bottom button bar ─────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource Lunai.SurfaceBrush}"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">

                <!-- Back (license step only) -->
                <Button Grid.Column="1"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.License}}"
                        Background="{StaticResource Lunai.SurfaceHighBrush}"
                        Foreground="{StaticResource Lunai.TextPrimaryBrush}"
                        Padding="20,10" CornerRadius="6" />

                <!-- Next (welcome + license) -->
                <Button Grid.Column="3"
                        Content="Next"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding Step, Converter={x:Static ObjectConverters.LessThan},
                                    ConverterParameter={x:Static models:WizardStep.Download}}"
                        Background="{StaticResource Lunai.PrimaryBrush}"
                        Foreground="{StaticResource Lunai.OnPrimary}"
                        Padding="20,10" CornerRadius="6" />

                <!-- Launch (done step) -->
                <Button Grid.Column="3"
                        Content="Launch"
                        Command="{Binding LaunchCommand}"
                        IsVisible="{Binding Step, Converter={x:Static ObjectConverters.Equal},
                                    ConverterParameter={x:Static models:WizardStep.Done}}"
                        Background="{StaticResource Lunai.SuccessBrush}"
                        Foreground="#FFFFFF"
                        Padding="20,10" CornerRadius="6" />

                <!-- Cancel (always, except done/error) -->
                <Button Grid.Column="5"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="{StaticResource Lunai.SurfaceHighBrush}"
                        Foreground="{StaticResource Lunai.TextSecondaryBrush}"
                        Padding="20,10" CornerRadius="6" />

            </Grid>
        </Border>

    </Grid>
</UserControl>
